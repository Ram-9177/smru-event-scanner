# Settings for https://smru-event-scanner.supercxo.ai. Copy to deploy/production.env (never commit it).
PUBLIC_URL=https://smru-event-scanner.supercxo.ai
# No ngrok on a server: leave NGROK_DOMAIN out.
SESSION_SECRET=put-a-random-string-of-at-least-32-characters-here
ADMIN_EMAIL=you@college.edu
ADMIN_PASSWORD=choose-a-first-password

# OneDrive (Entra app registration). Add these redirect URIs to the app in Entra first:
#   https://smru-event-scanner.supercxo.ai/admin/onedrive/callback
#   https://smru-event-scanner.supercxo.ai/auth/microsoft/callback
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Email (optional): smtp://user:pass@host:587
# SMTP_URL=
# View cache for thumbnails and main-view copies on the server, in MB
# IMG_CACHE_MB=300
