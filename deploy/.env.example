# Settings for https://smru-event-scanner.supercxo.ai. Copy to deploy/.env (never commit it), fill it in, then:
#   cd deploy && docker compose up -d --build
# This one file holds everything; Compose adds DATABASE_URL, REDIS_URL, HOST and TRUST_PROXY itself.
# Quote values in single quotes: Compose then reads them exactly as written (a $ is not treated as a variable).
PUBLIC_URL='https://smru-event-scanner.supercxo.ai'
# No ngrok on a server: leave NGROK_DOMAIN out (it would replace PUBLIC_URL).

# At least 32 characters. Bringing a database over from another copy? Use that copy's secret (on a Mac started
# without one: server/data/dev-secret): it unlocks the OneDrive sign-in kept in the database.
SESSION_SECRET='put-a-random-string-of-at-least-32-characters-here'

# First organiser (only used while the database has no organiser yet)
ADMIN_EMAIL='you@college.edu'
ADMIN_PASSWORD='choose-a-first-password'
ORG_NAME="St. Mary's"

# OneDrive and Microsoft sign-in (Entra app registration). Add this redirect URI to the app in Entra first:
#   https://smru-event-scanner.supercxo.ai/admin/onedrive/callback
MS_TENANT_ID=''
MS_CLIENT_ID=''
MS_CLIENT_SECRET=''

# Email (optional): smtp://user:pass@host:587
# SMTP_URL=''
# View cache for thumbnails and main-view copies on the server, in MB (0 = off)
IMG_CACHE_MB='300'

# The database: Docker Compose makes it with this password (letters and digits only; the server will not start
# without it)
POSTGRES_PASSWORD=put-a-long-random-string-of-letters-and-digits-here
