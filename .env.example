# Event Photos - settings. Copy this file to server/.env and fill in what you need.
# Needs PostgreSQL 16 and Redis 7 (npm run launch starts both on a Mac with Homebrew). Without the three Microsoft
# values below a local folder stands in for OneDrive.

# ---- the one link -----------------------------------------------------------------
# in production: https://photos.your-domain  (this is what the QR encodes)
PUBLIC_URL=http://localhost:3000
PORT=3000
# The fixed ngrok domain (from the ngrok dashboard, Domains), without https://. When set, the one link (QR, share kit,
# emails, the Microsoft redirect) is https://NGROK_DOMAIN whatever PUBLIC_URL says, and the start script keeps the
# tunnel up: it reuses an ngrok that already runs for this domain (never a second one), else starts
# "ngrok http --url=https://NGROK_DOMAIN <PORT>" and starts it again if it stops. ngrok needs its authtoken set once:
# ngrok config add-authtoken <token>
# NGROK_DOMAIN=galleried-warless-petronila.ngrok-free.dev
# off: the start script leaves ngrok alone (you run it yourself)
# PUBLIC_TUNNEL=on
# The ngrok program, if it is not on PATH, /opt/homebrew/bin or /usr/local/bin
# NGROK_PATH=
# ngrok's local API, only if you changed its web_addr
# NGROK_API=http://127.0.0.1:4040/api/tunnels
# HOST=127.0.0.1 keeps the app to this computer (the one-step start sets it). Leave it out on a server.
# HOST=
# Which proxy may pass the visitor's address: loopback (default) = one on this computer, as ngrok or Caddy. Keep it
# with a tunnel, or every student looks like one address.
# TRUST_PROXY=loopback
# Selfie searches from one network address in 10 minutes (0 = no limit)
# SEARCHES_PER_IP_10_MIN=60

# ---- first organiser (created on the first start, when there is no user yet) --------
ADMIN_EMAIL=you@college.edu
ADMIN_PASSWORD=change-me-to-a-long-password
ORG_NAME=St. Mary's
# The campuses made on the first start (afterwards: Settings)
# CAMPUSES=Hyderabad,Chebrolu,Budampadu

# ---- production ---------------------------------------------------------------------
# NODE_ENV=production
# 32+ random characters. Signs image links; encrypts the stored Microsoft sign-in.
# SESSION_SECRET=
# Sign-in tokens are JWTs signed with RS256. Without these a key pair is made once in DATA_DIR/jwt-rs256.pem.
# Give the PEM on one line with \n for the line breaks. JWT_PUBLIC_KEY is optional (it follows from the private key).
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# ---- database and cache ----------------------------------------------------------------
# PostgreSQL 16 (through Knex; tables are made and updated by migrations at start)
DATABASE_URL=postgres://localhost:5432/event_photos
# Redis 7: sign-in limits, signed-out tokens, one-time links
REDIS_URL=redis://127.0.0.1:6379
# REDIS_PREFIX=ep:
# display copies (about 0.5 MB a photo) and temp files
# DATA_DIR=./data
# Database backups (pg_dump, custom format): two minutes after start, then every BACKUP_EVERY_HOURS, newest BACKUP_KEEP
# kept. Default folder: backups/ at the top of the project. BACKUP_DIR=off switches them off. PG_DUMP if not found.
# BACKUP_DIR=../backups
# BACKUP_KEEP=14
# BACKUP_EVERY_HOURS=24
# PG_DUMP=/opt/homebrew/opt/postgresql@16/bin/pg_dump

# ---- OneDrive (Microsoft Graph) -------------------------------------------------------
# Fill in these three and start the app again: it then uses OneDrive, and Settings shows Connect OneDrive.
# (Without them the folder data/drive stands in for OneDrive. DRIVE=local forces that; DRIVE=graph forces OneDrive.)
# Directory (tenant) ID
# MS_TENANT_ID=
# Application (client) ID
# MS_CLIENT_ID=
# the secret's Value, not its Secret ID (it expires after at most 24 months)
# MS_CLIENT_SECRET=
# Only if the address Microsoft should come back to is not PUBLIC_URL/admin/onedrive/callback:
# MS_REDIRECT_URI=https://photos.your-domain/admin/onedrive/callback
# If your Microsoft 365 does not allow an app its own folder, Settings offers "Connect with the wider permission".
# Nothing to set here for that. (MS_ROOT=folder makes the wider permission the first choice.)
# With the wider permission the app keeps to one folder of the signing-in account's OneDrive, "Event Photos" at the top
# by default (made if missing). To use a folder you already have, give its name, or its path from the top of OneDrive:
# MS_ROOT_FOLDER=Photos/Event Photos

# ---- who students can ask ------------------------------------------------------------------
# Shown on the My data page and on the page of a closed album.
# CONTACT=IT Help Desk, helpdesk@college.edu

# ---- email (Nodemailer) -------------------------------------------------------------------
# Password-reset links, team invitations and alerts. Without SMTP_URL the emails are saved in DATA_DIR/outbox instead
# (and alerts show only in the console).
# SMTP_URL=smtp://user:password@smtp.office365.com:587
# MAIL_FROM=Event Photos <photos@college.edu>

# ---- alerts (banners in the console; emails to super admins when SMTP_URL is set) ---------------
# Minutes between checks
# ALERTS_EVERY_MIN=5
# The morning summary (uploads waiting for approval, open requests) from this hour, server time; -1 = none
# ALERT_DIGEST_HOUR=9
# Free space on the disk that holds DATA_DIR (the database, backups and temp files only: photos are in OneDrive):
# a warning below this many GB, critical below the second
# ALERT_DISK_WARN_GB=5
# ALERT_DISK_CRITICAL_GB=2
# The newest database backup older than this many hours: an alert
# ALERT_BACKUP_MAX_AGE_HOURS=48
# Warn this many days before the OneDrive client secret (or the stored sign-in) runs out
# ALERT_EXPIRY_DAYS=14
# When the client secret runs out (Entra, Certificates & secrets, Expires), YYYY-MM-DD. Empty = not known (no alert).
# MS_CLIENT_SECRET_EXPIRES=2027-11-01

# ---- storage: photos and videos live only in OneDrive (the app's copies in "_app copies (do not edit)") ----
# Uploads are refused while this Mac has less free than this many GB for temporary files (UPLOAD_MIN_FREE_GB, the
# older name, is still read). A video needs about 2.3 times its size on top.
# TEMP_MIN_FREE_GB=1
# Room in OneDrive for full-quality download copies kept for the next student (the least recently used go first)
# FULL_COPIES_GB=50
# Keep a location-free copy of each video in OneDrive for downloads (off: made per download in a temp file)
# CLEAN_VIDEO_COPIES=on
# How the album's videos reach the browser: redirect (straight from OneDrive) or pipe (through this server; use it
# if "Check everything" says OneDrive's links do not suit Safari)
# VIDEO_VIA=redirect
# OneDrive download links: their life when the link does not say (minutes), and how much of it must be left
# DRIVE_URL_LIFE_MIN=55
# DRIVE_URL_MARGIN_MIN=20
# How long a browser keeps the album's redirect to a copy (seconds)
# IMG_REDIRECT_MAX_AGE=300
# Copies streamed through this server at the same moment (share, save, VIDEO_VIA=pipe)
# PIPES_AT_ONCE=16
# Thumbnails and main-view copies kept on this Mac so the album opens fast, at most this many MB (0 = off).
# Least recently viewed are dropped first. Originals, videos and downloads stay only in OneDrive.
# IMG_CACHE_MB=300
# The copies job: copies made again from the originals at the same moment, and at most this many a minute
# REBUILD_AT_ONCE=2
# REBUILD_PER_MIN=60
# Scene descriptions held in memory while same shots are compared (MB)
# SCENE_CACHE_MB=256
# A photo handed to a student is cleaned in memory up to this size (MB); a larger one goes through a temp file
# HANDOVER_MAX_MB=80

# ---- Keep me updated (students opt in to hear about new photos of them) ------------------------
# off: not offered, and no matching of new photos against kept faces
# KEEP_UPDATED=on
# Web Push keys (VAPID). Leave empty: a pair is made once and kept in DATA_DIR/vapid.json. Changing them means
# students have to turn notifications on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Who the push services may contact: default the https link, else mailto:no-reply@localhost
# VAPID_SUBJECT=mailto:photos@college.edu

# ---- face data expiry --------------------------------------------------------------------------
# "Delete face data N days after the event" for NEW events (existing events are not changed); 0 = not set
# FACE_DAYS_DEFAULT=90
# Minutes between runs of the job that closes albums on their close date and deletes expired face data
# EXPIRY_EVERY_MIN=60

# ---- Sign in with Microsoft (OpenID Connect) ----------------------------------------------
# On by itself when the three Microsoft values above are set; organisers of that directory whose email is in Team
# can then sign in with their Microsoft 365 account. MS_SSO=off hides the button.
# Microsoft comes back to the OneDrive address (already registered); set this only to use another registered one:
# MS_SSO_REDIRECT_URI=https://photos.your-domain/auth/microsoft/callback

# ---- face engine (inside the server: YuNet + SFace through OpenCV, in worker threads) -------
# where the two model files are (npm run launch downloads them once)
# FACE_MODELS=./models
# FACE_WORKERS=2

# ---- stand-in for OneDrive (when OneDrive is not set up) ---------------------------------------------
# The folder that plays OneDrive's Event Photos folder: one folder inside it per event.
# LOCAL_DRIVE_DIR=./data/drive

# ---- cut-offs: set these from the proof test ----------------------------------------------
# FACE_SURE=0.50
# FACE_MAYBE=0.40
# DUP_BITS=32
